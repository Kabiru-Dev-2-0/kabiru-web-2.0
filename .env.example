# ==============================================================
# Template Environment Variables - kabiru-website
# Salin file ini ke .env.local untuk development lokal
# ==============================================================

# --- Production (Supabase Cloud) ---
# NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon-key>

# --- Lokal (supabase start) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon-key-dari-output-supabase-start>

# --- Google OAuth (untuk lokal) ---
# Tambahkan redirect URI di Google Cloud Console:
#   http://localhost:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<google-client-id>
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<google-client-secret>

# --- GitHub OAuth (lebih mudah untuk local dev) ---
# github.com/settings/developers -> New OAuth App
# Callback URL: http://localhost:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=<github-client-id>
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=<github-client-secret>

# --- GitHub OAuth (lebih mudah untuk local dev) ---
# github.com/settings/developers → New OAuth App
# Callback URL: http://localhost:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=<github-client-id>
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=<github-client-secret>
